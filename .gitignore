# MindSpec local runtime files — not version-controlled.
# Phase is derived from beads (ADR-0023). These are transient.
.mindspec/session.json
.mindspec/current-spec.json

# spec 128 R3.3 — the mindspec_phase write lock's dedicated lockfile
# (internal/phase/phaselock.go). It carries no meaningful content of its
# own: the OS-level lock (flock/LockFileEx) is the mutual-exclusion
# primitive, never the file's bytes.
.mindspec/phase.lock

# spec 117 — the panel-disposition store's dedicated per-panel lockfile
# (internal/panel/disposition_store.go). It serializes concurrent
# `mindspec panel disposition append`/`check` invocations on
# <spec-dir>/reviews/<panel>/dispositions.lock and is never the durable
# data file (dispositions.jsonl, version-controlled; spec 130 R6); it is a
# local runtime artifact, not part of the telemetry the store records.
**/reviews/*/dispositions.lock

# spec 129 R8: panel reviews are a local helper, not version-controlled (already-tracked files stay tracked; R8.4 option (B): dispositions.jsonl is tracked)
.mindspec/specs/*/reviews/**
.mindspec/reviews/**
!.mindspec/specs/*/reviews/*/
!.mindspec/specs/*/reviews/*/dispositions.jsonl

# Beads runtime artifacts are handled by .beads/.gitignore
# This rule catches any stray runtime files outside .beads/
**/bd.sock

# Stray beads export that the bd pre-commit hook occasionally drops at the
# repo root (the canonical copy lives at .beads/issues.jsonl).
/issues.jsonl

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Go
bin/
/mindspec
*.exe

# Go workspace files. Spec 084 removed the agentmind sibling
# materialization (see ADR-0027); these patterns remain so any
# locally-generated go.work from a stale checkout is still ignored.
/go.work
/go.work.sum

# OS
.DS_Store
Thumbs.db

# beads git submodule
beads/

# mindspec worktrees
.worktrees/

# local harness run artifacts
.harness_runs/
.harness-runs/

# Dolt database files (added by bd init)
.dolt/
*.db

# Beads / Dolt files (added by bd init)
.beads-credential-key
